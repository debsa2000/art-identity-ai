{
  "version": 1,
  "sdk_version": "0.22.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://pnhvzjvrbtivmlloyucs.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "art-identity-ai",
      "version": "0.1.0",
      "title": "Art Identity AI"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my artist profile",
        "description": "Return the signed-in artist's full profile: name, slug, bio, location, medium, Instagram, application status, completion percent, and public URL.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "update_my_profile",
        "title": "Update my profile",
        "description": "Update editable fields on the signed-in artist's profile. Only provided fields are changed.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "artist_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "bio": {
              "type": "string",
              "maxLength": 4000
            },
            "city": {
              "type": "string",
              "maxLength": 120
            },
            "country": {
              "type": "string",
              "maxLength": 120
            },
            "medium": {
              "type": "string",
              "maxLength": 200
            },
            "style": {
              "type": "string",
              "maxLength": 200
            },
            "instagram": {
              "type": "string",
              "maxLength": 120
            },
            "price_range": {
              "type": "string",
              "maxLength": 120
            },
            "exhibitions": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_artworks",
        "title": "List my artworks",
        "description": "List the signed-in artist's artworks with title, medium, year, dimensions, price, and status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max rows (default 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_artwork",
        "title": "Create artwork",
        "description": "Create a new artwork on the signed-in artist's profile. Fifteen-artwork cap is enforced server-side.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "medium": {
              "type": "string",
              "maxLength": 200
            },
            "year": {
              "type": "integer",
              "minimum": 1800,
              "maximum": 2100
            },
            "width_cm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height_cm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "depth_cm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "price": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3,
              "description": "ISO 4217, e.g. USD"
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_inquiries",
        "title": "List my inquiries",
        "description": "List collector/gallery inquiries received by the signed-in artist, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "unread_only": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_directory",
        "title": "Search public artist directory",
        "description": "Search the public Art Identity AI artist directory. Returns published, publicly listed artists — name, slug, city/country, medium, and public page URL.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "maxLength": 120,
              "description": "Match against name, city, or medium."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
